<% upload_settings = Decidim.organization_settings(current_organization) %>
<%= response_form.upload :add_attachments,
                         attachments: response.attachments,
                         label: false,
                         multiple: true,
                         id: field_id,
                         disabled:,
                         button_class: "button button__lg button__transparent-secondary w-full",
                         extension_allowlist: upload_settings.upload_allowed_file_extensions,
                         max_file_size: upload_settings.upload_maximum_file_size,
                         help_text: questionnaire_file_upload_help(response.question) %>
