        verifications:
          document_types: ["identification_number", "passport"]

      storage_default: &storage_default
        provider: "local"

      default: &default
        secret_key_base: "6a8af371b2b759541f253fd351431319d1c6d6ee8073419b911737e820a54cd7d6f00ac4e40c6dc107b3ee70d312dfe0ff236e49f9d95cfb10df2f8746b25712"
        decidim:
          <<: *decidim_default
        omniauth:
          facebook:
            enabled: "false"
          twitter:
            enabled: "false"
          google_oauth2:
            enabled: "false"
        maps:
          dynamic_provider: ""
          static_provider: ""
        storage:
          <<: *storage_default
        vapid:
          enabled: "false"

      development:
        <<: *default

      test:
        <<: *default
        omniauth:
          facebook:
            enabled: true
            app_id: fake-facebook-app-id
            app_secret: fake-facebook-app-secret
          twitter:
            enabled: true
            api_key: fake-twitter-api-key
            api_secret: fake-twitter-api-secret
          google_oauth2:
            enabled: true
            client_id:
            client_secret:
          test:
            enabled: true
            icon: tools-line

      production:
        <<: *default
    YAML
  end

  initializer = File.join(dummy_root, "config/initializers/decidim.rb")
  return if File.exist?(initializer)

  template = Gem.loaded_specs["decidim-generators"]&.full_gem_path
  template &&= File.join(template, "lib/decidim/generators/app_templates/initializer.rb")
  if template && File.exist?(template)
    FileUtils.cp(template, initializer)
