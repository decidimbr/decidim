end

desc "Generates a dummy app for testing"
task :test_app do
  expand_bundle_gemfile!
  # Do not wrap in Bundler.with_original_env — that can pick a non-BUNDLE_PATH
  # Rails and emit Rails 8-shaped templates under a 0.29 image.
  generate_decidim_app(
    "spec/decidim_dummy_app",
    "--app_name",
    "#{base_app_name}_test_app",
    "--path",
    "../..",
    "--skip_spring",
    "--demo",
    "--force_ssl",
    "false",
    "--locales",
    "en,ca,es"
  )

  dummy_root = File.expand_path("spec/decidim_dummy_app", __dir__)
  dummy_gemfile = File.join(dummy_root, "Gemfile")
  gemfile_contents = File.read(dummy_gemfile)
  File.open(dummy_gemfile, "a") do |f|
    unless gemfile_contents.include?("decidim-extra_blocks")
      f.puts %(gem "decidim-extra_blocks", path: "../..")
    end
    # Shakapacker 7.1 + rack-proxy 1.x → 502 on /decidim-packs (0.29)
    if legacy_decidim? && !gemfile_contents.include?(%(gem "rack-proxy"))
      f.puts %(gem "rack-proxy", "< 1.0")
    end
  end

  patch_dummy_app_rails70!(dummy_root)

  # Generators may leave a mismatched .ruby-version (e.g. 3.4) under 0.29.
  ruby_version_file = File.join(dummy_root, ".ruby-version")
  if File.exist?(ruby_version_file)
    File.write(ruby_version_file, "#{legacy_decidim? ? "3.2.2" : "3.4.7"}\n")
  end

  # Keep JS packs on the Decidim minor under test (generator/npm may write 0.32 pins).
  package_json = File.join(dummy_root, "package.json")
  if File.exist?(package_json) && ENV.fetch("DECIDIM_VERSION", "~> 0.29.7").include?("0.29")
    ensure_shakapacker_stub!(dummy_root)
    File.write(
      package_json,
      <<~JSON
        {
          "name": "decidim-extra-blocks-test-app",
          "private": true,
          "version": "0.1.0",
          "dependencies": {
            "@decidim/browserslist-config": "0.29.7",
            "@decidim/core": "0.29.7",
            "@decidim/webpacker": "0.29.7",
            "sass-embedded": "1.69.5"
          },
          "devDependencies": {
            "@decidim/dev": "0.29.7",
            "shakapacker": "file:packages/shakapacker-stub"
          },
          "browserslist": [
            "extends @decidim/browserslist-config"
          ],
          "overrides": {
            "sass-embedded": "1.69.5"
          }
        }
      JSON
    )
  end

  ensure_shakapacker_stub!(dummy_root)
  prepare_dummy_decidim_boot_files!(dummy_root)

  # Decidim 0.29 needs config/initializers/decidim.rb + secrets.yml (do not remove).
  File.write(File.join(dummy_root, ".decidim_appraisal"), ENV.fetch("BUNDLE_GEMFILE", "Gemfile"))

  run!(dummy_root, "bundle install")

  Rake::Task["prepare_tests"].invoke
end

desc "Prepare test database for dummy app (optional Docker compose)"
task :prepare_tests do
  expand_bundle_gemfile!
  disable_docker_compose = ENV.fetch("DISABLED_DOCKER_COMPOSE", "false") == "true"
  unless disable_docker_compose
    compose = File.expand_path("docker-compose.yml", __dir__)
    system("docker-compose -f #{compose} down -v --remove-orphans") if File.exist?(compose)
    system("docker-compose -f #{compose} up -d") if File.exist?(compose)
  end

  common_db_config = {
    "adapter" => "postgresql",
    "encoding" => "unicode",
    "host" => ENV.fetch("DATABASE_HOST", "localhost"),
    "port" => ENV.fetch("DATABASE_PORT", "5432").to_i,
    "username" => ENV.fetch("DATABASE_USERNAME", "decidim"),
    "password" => ENV.fetch("DATABASE_PASSWORD", "decidim")
  }

  dummy_root = File.expand_path("spec/decidim_dummy_app", __dir__)
  patch_dummy_app_rails70!(dummy_root)
  ensure_shakapacker_stub!(dummy_root)
  prepare_dummy_decidim_boot_files!(dummy_root)
  ruby_version_file = File.join(dummy_root, ".ruby-version")
  if File.exist?(ruby_version_file)
    File.write(ruby_version_file, "#{legacy_decidim? ? "3.2.2" : "3.4.7"}\n")
  end

  # System specs use HTTP; never leave force_ssl on in the dummy test env.
  test_env = File.join(dummy_root, "config/environments/test.rb")
  if File.exist?(test_env)
    contents = File.read(test_env)
    unless contents.include?("config.force_ssl")
      File.write(
        test_env,
        contents.sub(
          "Rails.application.configure do\n",
          "Rails.application.configure do\n  config.force_ssl = false\n"
        )
      )
    end
  end

  config_file = File.join(dummy_root, "config/database.yml")
  FileUtils.mkdir_p(File.dirname(config_file))
  File.open(config_file, "w") do |f|
    YAML.dump(
      {
        "test" => common_db_config.merge("database" => "#{base_app_name}_test_app_test"),
        "development" => common_db_config.merge("database" => "#{base_app_name}_test_app_development")
      },
      f
    )
  end

  prior_database_url = ENV.delete("DATABASE_URL")
  prior_rails_env = ENV["RAILS_ENV"]
  prior_disable_spring = ENV["DISABLE_SPRING"]
  prior_db_env_check = ENV["DISABLE_DATABASE_ENVIRONMENT_CHECK"]
  begin
    ENV["RAILS_ENV"] = "test"
    ENV["DISABLE_SPRING"] = "1"
    ENV["DISABLE_DATABASE_ENVIRONMENT_CHECK"] = "1"

    run!(dummy_root, "bundle exec rake decidim:choose_target_plugins")
    prepare_dummy_decidim_boot_files!(dummy_root)
    run!(dummy_root, "bundle exec rails railties:install:migrations")
    prepare_dummy_decidim_boot_files!(dummy_root)
    purge_non_legacy_dummy_migrations!(dummy_root) if legacy_decidim?

    normalize_variant_migrations!(dummy_root)

    run!(dummy_root, "bundle exec rake db:drop db:create db:migrate db:schema:dump")
    prepare_dummy_decidim_boot_files!(dummy_root)

    # Rails 7.0 Active Storage may not ship variant_records; Decidim attachments expect it.
    if legacy_decidim?
      run!(
        dummy_root,
        "bundle exec rails runner \"" \
        "unless ActiveRecord::Base.connection.table_exists?(:active_storage_variant_records); " \
        "ActiveRecord::Base.connection.create_table(:active_storage_variant_records) do |t|; " \
        "t.belongs_to :blob, null: false, index: false; t.string :variation_digest, null: false; " \
        "t.index %i[blob_id variation_digest], name: 'index_active_storage_variant_records_uniqueness', unique: true; " \
        "end; end\""
      )
    end
  ensure
    if prior_rails_env
      ENV["RAILS_ENV"] = prior_rails_env
    else
      ENV.delete("RAILS_ENV")
    end
    ENV["DATABASE_URL"] = prior_database_url if prior_database_url
    if prior_disable_spring
      ENV["DISABLE_SPRING"] = prior_disable_spring
    else
      ENV.delete("DISABLE_SPRING")
    end
    if prior_db_env_check
      ENV["DISABLE_DATABASE_ENVIRONMENT_CHECK"] = prior_db_env_check
    else
      ENV.delete("DISABLE_DATABASE_ENVIRONMENT_CHECK")
    end
  end
end
