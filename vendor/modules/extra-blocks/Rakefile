# frozen_string_literal: true

require "fileutils"
require "rake"
require "rake/file_utils"
require "yaml"

require "decidim/dev/common_rake"

def base_app_name
  "decidim_extra_blocks"
end

# Appraisal/CI often set a relative BUNDLE_GEMFILE; dummy chdir breaks that path.
def expand_bundle_gemfile!
  gemfile = ENV["BUNDLE_GEMFILE"]
  return if gemfile.nil? || gemfile.empty? || File.absolute_path?(gemfile)

  ENV["BUNDLE_GEMFILE"] = File.expand_path(gemfile, __dir__)
end

def legacy_decidim?
  Gem.loaded_specs.fetch("decidim-core").version < Gem::Version.new("0.32")
end

# Decidim 0.29 expects Rails 7.0 defaults. Some generators leave Rails 8-shaped
# application.rb (load_defaults 8.1 + autoload_lib) which boots fail on 7.0.10.
def patch_dummy_app_rails70!(dummy_root)
  return unless legacy_decidim?

  application_rb = File.join(dummy_root, "config/application.rb")
  return unless File.exist?(application_rb)

  contents = File.read(application_rb)
  patched = contents
            .gsub(/config\.load_defaults\s+[\d.]+/, "config.load_defaults 7.0")
            .gsub(/^[ \t]*config\.autoload_lib\(.*\n/, "")
  File.write(application_rb, patched) if patched != contents
end

def run!(cwd, command)
  FileUtils.chdir(cwd) { sh(command) }
end

# Keep the file: stub aligned with the Shakapacker gem used by each appraisal.
def ensure_shakapacker_stub!(dummy_root)
  stub_dir = File.join(dummy_root, "packages/shakapacker-stub")
  FileUtils.mkdir_p(stub_dir)
  File.write(File.join(stub_dir, "package.json"), <<~JSON)
    {"name": "shakapacker", "version": "#{legacy_decidim? ? "7.1.0" : "9.7.0"}"}
  JSON
end

def copy_env_storage_config!(dummy_root)
  generators = Gem.loaded_specs.fetch("decidim-generators").full_gem_path
  source = File.join(generators, "lib/decidim/generators/app_templates/storage.yml")
  FileUtils.cp(source, File.join(dummy_root, "config/storage.yml"))
end

def prepare_dummy_decidim_boot_files!(dummy_root)
  return ensure_dummy_decidim_boot_files!(dummy_root) if legacy_decidim?

  FileUtils.rm_f(File.join(dummy_root, "config/secrets.yml"))
  FileUtils.rm_f(File.join(dummy_root, "config/initializers/decidim.rb"))
  FileUtils.rm_f(File.join(dummy_root, "package-lock.json"))
  copy_env_storage_config!(dummy_root)
end

def normalize_variant_migrations!(dummy_root)
  pattern = File.join(dummy_root, "db/migrate/*_create_active_storage_variant_records.decidim.rb")
  migrations = Dir.glob(pattern)
  FileUtils.rm_f(legacy_decidim? ? migrations : migrations[0...-1])
end

# Drop migrations not shipped by the installed Decidim 0.29.* / toggle gems
# (vendor volumes or mixed installs can leave newer Migration[7.2]/[8.x] files).
def purge_non_legacy_dummy_migrations!(dummy_root)
  migrate_dir = File.join(dummy_root, "db/migrate")
  return unless Dir.exist?(migrate_dir)

  allowed_origins = {}
  Gem.loaded_specs.each_value do |spec|
    next unless spec.name.start_with?("decidim") || spec.name == "activestorage"

    Dir.glob(File.join(spec.full_gem_path, "db/migrate/*.rb")).each do |path|
      basename = File.basename(path)
      origin = basename[/\A(\d+)/, 1]
      allowed_origins[origin] = true if origin
    end
  end

  Dir.glob(File.join(migrate_dir, "*.rb")).each do |path|
    contents = File.read(path)
    if contents.match?(/ActiveRecord::Migration\[(?:7\.[1-9]|8)/)
      FileUtils.rm_f(path)
      next
    end

    origin = contents[/originally (\d+)/, 1]
    next unless origin
    next if allowed_origins[origin]

    FileUtils.rm_f(path)
  end
end

# Generators sometimes omit or later cleanup wipes these; Decidim 0.29 needs both to boot.
def ensure_dummy_decidim_boot_files!(dummy_root)
  secrets = File.join(dummy_root, "config/secrets.yml")
  unless File.exist?(secrets)
    File.write(secrets, <<~YAML)
      # Be sure to restart your server when you modify this file.

      decidim_default: &decidim_default
        application_name: "Extra Blocks Test"
        mailer_sender: "change-me@example.org"
        available_locales: ["en", "ca", "es"]
        default_locale: en
        # false (boolean) — string "false" is .present? and wrongly enables force_ssl.
        force_ssl: false
        enable_html_header_snippets: "false"
        currency_unit: "€"
        cors_enabled: "false"
        image_uploader_quality: 80
        maximum_attachment_size: 10
        maximum_avatar_size: 5
        max_reports_before_hiding: 3
        track_newsletter_links: "true"
        download_your_data_expiry_time: 7
        throttling_max_requests: 100
        throttling_period: 1
        unconfirmed_access_for: 0
        system_accesslist_ips: []
        base_uploads_path:
        default_csv_col_sep: ";"
        consent_cookie_name: "decidim-consent"
        cache_key_separator: "/"
        cache_expiry_time: 1440
        stats_cache_expiry_time: 10
        expire_session_after: 30
        session_timeout_interval: 10
        enable_remember_me: "true"
        follow_http_x_forwarded_host: "false"
        maximum_conversation_message_length: 1000
        password_similarity_length: 4
        denied_passwords: []
        allow_open_redirects: "false"
        social_share_services: ["X", "Facebook", "WhatsApp", "Telegram"]
        service_worker_enabled: "false"
        page_blocks: ["terms-of-service"]
