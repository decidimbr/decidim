<%= content_tag(
  :section,
  class: "extra-blocks-brand-story #{prose_classes}",
  id: "extra-block-#{model.id}",
  data: { extra_blocks_category: "timelines" },
  style: section_style
) do %>
  <div class="extra-blocks-brand-story__inner">
    <% if title.present? %>
      <h2 class="extra-blocks__title extra-blocks-brand-story__title"><%= title %></h2>
    <% end %>
    <% if events.any? %>
      <ol class="extra-blocks-brand-story__events">
        <% events.each_with_index do |event, position| %>
          <li class="extra-blocks-brand-story__event extra-blocks-brand-story__event--<%= position.even? ? "left" : "right" %><%= " extra-blocks-brand-story__event--highlighted" if event[:highlighted] %>">
            <div class="extra-blocks-brand-story__marker" aria-hidden="true"></div>
            <div class="extra-blocks-brand-story__card">
              <% if event[:date].present? %>
                <p class="extra-blocks-brand-story__date"><%= event[:date] %></p>
              <% end %>
              <% if event[:image_uploader].present? %>
                <div class="extra-blocks__media extra-blocks-brand-story__media">
                  <%= extra_blocks_picture_tag event[:image_uploader], mode: :fixed, class: "extra-blocks-brand-story__image not-prose", alt: "" %>
                </div>
              <% end %>
              <% if event[:title].present? %>
                <h3 class="extra-blocks-brand-story__event-title"><%= event[:title] %></h3>
              <% end %>
              <% if event[:body].present? %>
                <p class="extra-blocks-brand-story__event-body"><%= event[:body] %></p>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
    <% end %>
  </div>
<% end %>
