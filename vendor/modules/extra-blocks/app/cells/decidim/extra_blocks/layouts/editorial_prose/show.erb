<%= content_tag(
  :section,
  class: "extra-blocks-editorial-prose #{prose_classes} extra-blocks-editorial-prose--image-#{image_position}",
  id: "extra-block-#{model.id}",
  data: { extra_blocks_category: "text" },
  style: section_style
) do %>
  <div class="extra-blocks-editorial-prose__inner">
    <% if lead_image? && image_position == "above" %>
      <div class="extra-blocks__media extra-blocks-editorial-prose__media">
        <%= extra_blocks_picture_tag lead_image_uploader, mode: :fixed, class: "extra-blocks-editorial-prose__image not-prose", alt: "" %>
      </div>
    <% end %>
    <% if eyebrow.present? %>
      <p class="extra-blocks__eyebrow extra-blocks-editorial-prose__eyebrow"><%= eyebrow %></p>
    <% end %>
    <% if title.present? %>
      <h2 class="extra-blocks__title extra-blocks-editorial-prose__title"><%= title %></h2>
    <% end %>
    <% if body.present? %>
      <div class="extra-blocks__description extra-blocks-editorial-prose__description"><%= body %></div>
    <% end %>
    <% if lead_image? && image_position == "below" %>
      <div class="extra-blocks__media extra-blocks-editorial-prose__media">
        <%= extra_blocks_picture_tag lead_image_uploader, mode: :fixed, class: "extra-blocks-editorial-prose__image not-prose", alt: "" %>
      </div>
    <% end %>
    <% if show_button? %>
      <div class="extra-blocks__action extra-blocks-editorial-prose__action">
        <%= link_to button_label, button_url, class: "button button__lg button__primary extra-blocks__button extra-blocks-editorial-prose__button not-prose" %>
      </div>
    <% end %>
  </div>
<% end %>
