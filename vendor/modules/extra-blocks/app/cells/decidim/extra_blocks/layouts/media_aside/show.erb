<%= content_tag(
  :section,
  class: "extra-blocks-media-aside #{prose_classes} extra-blocks-media-aside--image-#{image_side}",
  id: "extra-block-#{model.id}",
  data: { extra_blocks_category: "text" },
  style: section_style
) do %>
  <div class="extra-blocks-media-aside__inner">
    <div class="extra-blocks-media-aside__text">
      <% if title.present? %>
        <h2 class="extra-blocks__title extra-blocks-media-aside__title not-prose"><%= title %></h2>
      <% end %>
      <% if body.present? %>
        <div class="extra-blocks__description extra-blocks-media-aside__description"><%= body %></div>
      <% end %>
      <% if show_button? %>
        <div class="extra-blocks__action extra-blocks-media-aside__action">
          <%= link_to button_label, button_url, class: "button button__lg button__primary extra-blocks__button extra-blocks-media-aside__button not-prose" %>
        </div>
      <% end %>
    </div>
    <% if slideshow? %>
      <div
        class="extra-blocks__media extra-blocks-media-aside__media"
        data-extra-blocks-media-aside-slideshow
        data-interval="5000"
      >
        <div class="extra-blocks-media-aside__slides" aria-live="polite">
          <% slides.each_with_index do |uploader, index| %>
            <%= extra_blocks_picture_tag uploader,
                                          mode: :fixed,
                                          picture: {
                                            class: "extra-blocks-media-aside__slide#{' is-active' if index.zero?}",
                                            data: { extra_blocks_media_aside_slide: true }
                                          },
                                          class: "extra-blocks-media-aside__image",
                                          alt: "" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
