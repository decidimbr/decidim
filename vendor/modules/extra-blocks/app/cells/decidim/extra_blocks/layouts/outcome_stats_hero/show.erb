<%= content_tag(
  :section,
  class: "extra-blocks-outcome-stats-hero #{prose_classes}",
  id: "extra-block-#{model.id}",
  data: { extra_blocks_category: "hero" },
  style: section_style
) do %>
  <div class="extra-blocks-outcome-stats-hero__inner">
    <div class="extra-blocks-outcome-stats-hero__intro">
      <% if title.present? %>
        <h2 class="extra-blocks__title extra-blocks-outcome-stats-hero__title"><%= title %></h2>
      <% end %>
      <% if intro.present? %>
        <p class="extra-blocks__description extra-blocks-outcome-stats-hero__description"><%= intro %></p>
      <% end %>
    </div>
    <% if stats.any? %>
      <ul class="extra-blocks-outcome-stats-hero__stats">
        <% stats.each do |stat| %>
          <li class="extra-blocks-outcome-stats-hero__stat">
            <% if stat[:value].present? %>
              <span class="extra-blocks-outcome-stats-hero__value"><%= stat[:value] %></span>
            <% end %>
            <% if stat[:label].present? %>
              <span class="extra-blocks-outcome-stats-hero__label"><%= stat[:label] %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% if show_button? %>
      <div class="extra-blocks__action extra-blocks-outcome-stats-hero__action">
        <%= link_to button_label, button_url, class: "button button__lg button__primary extra-blocks__button extra-blocks-outcome-stats-hero__button not-prose" %>
      </div>
    <% end %>
  </div>
<% end %>
