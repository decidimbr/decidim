<%= content_tag(
  :section,
  class: "extra-blocks-proposals-aside-fast-proposal #{prose_classes}",
  id: "extra-block-#{model.id}",
  data: { extra_blocks_category: "fast_proposal" },
  style: section_style
) do %>
  <% if background_image? %>
    <%= extra_blocks_picture_tag background_image_uploader,
                                  mode: :full_width,
                                  class: "extra-blocks__media extra-blocks-proposals-aside-fast-proposal__image not-prose",
                                  alt: "" %>
  <% end %>
  <div class="extra-blocks-proposals-aside-fast-proposal__inner">
    <div class="extra-blocks-proposals-aside-fast-proposal__form">
      <%= cell(
            "decidim/extra_blocks/layouts/fast_proposal_form",
            model,
            proposal_component:
          ) %>
    </div>
    <div class="extra-blocks-proposals-aside-fast-proposal__aside">
      <div class="extra-blocks-proposals-aside-fast-proposal__intro">
        <% if eyebrow.present? %>
          <p class="extra-blocks__eyebrow extra-blocks-proposals-aside-fast-proposal__eyebrow"><%= eyebrow %></p>
        <% end %>
        <% if title.present? %>
          <h2 class="extra-blocks__title extra-blocks-proposals-aside-fast-proposal__title"><%= title %></h2>
        <% end %>
        <% if description.present? %>
          <div class="extra-blocks__description extra-blocks-proposals-aside-fast-proposal__description"><%= description %></div>
        <% end %>
      </div>
      <% if aside_proposals.any? %>
        <ul class="extra-blocks-proposals-aside-fast-proposal__list">
          <% aside_proposals.each do |proposal| %>
            <li class="extra-blocks-proposals-aside-fast-proposal__item">
              <%= link_to proposal_path(proposal),
                          class: "extra-blocks__card extra-blocks-proposals-aside-fast-proposal__card" do %>
                <p class="extra-blocks-proposals-aside-fast-proposal__snippet"><%= proposal_snippet(proposal) %></p>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
<% end %>
