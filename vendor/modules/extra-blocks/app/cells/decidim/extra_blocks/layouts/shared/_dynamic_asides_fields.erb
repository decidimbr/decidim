<%# locals: settings_fields, images_fields, content_block %>
<%
  scope = "decidim.extra_blocks.layouts.shared.dynamic_asides"
  slot_count = Decidim::ExtraBlocks::Layouts::DynamicAsides::SLOT_COUNT
  asides_json = Decidim::ExtraBlocks::Layouts::DynamicAsides.form_json_for_settings(
    content_block,
    settings_fields.object
  )
%>

<div class="row column">
  <%= cell(
        "decidim/announcement",
        { title: t("#{scope}.callout_title"), body: t("#{scope}.callout_body") },
        callout_class: "warning"
      ) %>
</div>

<div
  class="extra-blocks-dynamic-slot-list"
  data-dynamic-slot-list
  data-slot-count="<%= slot_count %>"
>
  <%= settings_fields.hidden_field :asides_json,
                                   value: asides_json,
                                   data: { dynamic_slot_list_json: true } %>

  <p class="help-text extra-blocks-dynamic-slot-list__empty" data-dynamic-slot-list-empty hidden>
    <%= t("#{scope}.empty") %>
  </p>
  <p class="help-text extra-blocks-dynamic-slot-list__max" data-dynamic-slot-list-max hidden>
    <%= t("#{scope}.max", count: slot_count) %>
  </p>

  <div class="extra-blocks-dynamic-slot-list__list" data-dynamic-slot-list-list></div>

  <div class="row column">
    <button type="button" class="button button__sm button__secondary" data-dynamic-slot-list-add>
      <%= t("#{scope}.add") %>
    </button>
  </div>

  <template data-dynamic-slot-list-row-template>
    <fieldset class="extra-blocks-dynamic-slot-list__row" data-dynamic-slot-list-row>
      <legend>
        <%= t("#{scope}.aside") %>
        #<span data-dynamic-slot-list-slot-label></span>
      </legend>

      <div class="row column" data-dynamic-slot-list-upload-mount></div>

      <div class="row column">
        <button type="button" class="button button__sm button__transparent-secondary" data-dynamic-slot-list-remove>
          <%= t("#{scope}.remove") %>
        </button>
      </div>
    </fieldset>
  </template>

  <div class="extra-blocks-dynamic-slot-list__uploads" data-dynamic-slot-list-uploads hidden>
    <% (1..slot_count).each do |slot| %>
      <div data-dynamic-slot-list-upload="<%= slot %>">
        <%= images_fields.upload :"aside_#{slot}_image",
                                 label: t("#{scope}.aside_image", number: slot) %>
        <p class="help-text"><%= t("#{scope}.aside_image_help") %></p>
      </div>
    <% end %>
  </div>
</div>
