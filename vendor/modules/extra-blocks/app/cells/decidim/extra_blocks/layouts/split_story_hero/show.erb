<%= content_tag(
  :section,
  class: "extra-blocks-split-story-hero #{prose_classes} extra-blocks-split-story-hero--image-#{image_side}",
  id: "extra-block-#{model.id}",
  data: { extra_blocks_category: "hero" },
  style: section_style
) do %>
  <div class="extra-blocks-split-story-hero__inner">
    <div class="extra-blocks-split-story-hero__text">
      <% if eyebrow.present? %>
        <p class="extra-blocks__eyebrow extra-blocks-split-story-hero__eyebrow"><%= eyebrow %></p>
      <% end %>
      <% if title.present? %>
        <h2 class="extra-blocks__title extra-blocks-split-story-hero__title"><%= title %></h2>
      <% end %>
      <% if body.present? %>
        <div class="extra-blocks__description extra-blocks-split-story-hero__description"><%= body %></div>
      <% end %>
      <% if show_button? %>
        <div class="extra-blocks__action extra-blocks-split-story-hero__action">
          <%= link_to button_label, button_url, class: "button button__lg button__primary extra-blocks__button extra-blocks-split-story-hero__button not-prose" %>
        </div>
      <% end %>
    </div>
    <% if side_image? %>
      <div class="extra-blocks__media extra-blocks-split-story-hero__media">
        <%= extra_blocks_picture_tag side_image_uploader, mode: :fixed, class: "extra-blocks-split-story-hero__image not-prose", alt: "" %>
      </div>
    <% end %>
  </div>
<% end %>
