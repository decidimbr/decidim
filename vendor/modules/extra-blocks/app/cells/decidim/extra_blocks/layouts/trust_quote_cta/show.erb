<%= content_tag(
  :section,
  class: "extra-blocks-trust-quote-cta #{prose_classes}",
  id: "extra-block-#{model.id}",
  data: { extra_blocks_category: "cta" },
  style: section_style
) do %>
  <div class="extra-blocks-trust-quote-cta__inner">
    <blockquote class="extra-blocks-trust-quote-cta__quote-block not-prose">
      <% if portrait? %>
        <%= extra_blocks_picture_tag portrait_uploader, mode: :fixed, class: "extra-blocks__media extra-blocks-trust-quote-cta__portrait not-prose", alt: attribution_name.to_s %>
      <% end %>
      <div class="extra-blocks-trust-quote-cta__quote-content">
        <% if quote.present? %>
          <p class="extra-blocks__description extra-blocks-trust-quote-cta__quote"><%= quote %></p>
        <% end %>
        <% if attribution_name.present? || attribution_role.present? %>
          <footer class="extra-blocks-trust-quote-cta__attribution">
            <% if attribution_name.present? %>
              <cite class="extra-blocks-trust-quote-cta__name"><%= attribution_name %></cite>
            <% end %>
            <% if attribution_role.present? %>
              <span class="extra-blocks-trust-quote-cta__role"><%= attribution_role %></span>
            <% end %>
          </footer>
        <% end %>
        <% if show_button? %>
          <div class="extra-blocks__action extra-blocks-trust-quote-cta__action">
            <%= link_to button_label, button_url,
                        class: "button button__lg button__primary extra-blocks__button extra-blocks-trust-quote-cta__button not-prose" %>
          </div>
        <% end %>
      </div>
    </blockquote>
  </div>
<% end %>
