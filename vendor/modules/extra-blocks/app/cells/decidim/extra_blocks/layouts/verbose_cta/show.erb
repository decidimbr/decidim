<%= content_tag(
  :section,
  class: "extra-blocks-verbose-cta #{prose_classes}",
  id: "extra-block-#{model.id}",
  data: { extra_blocks_category: "cta" },
  style: section_style
) do %>
  <div class="extra-blocks-verbose-cta__inner">
    <div class="extra-blocks-verbose-cta__text">
      <% if title.present? %>
        <h2 class="extra-blocks__title extra-blocks-verbose-cta__title"><%= title %></h2>
      <% end %>
      <% if body.present? %>
        <div class="extra-blocks__description extra-blocks-verbose-cta__description"><%= body %></div>
      <% end %>
    </div>
    <% if show_button? %>
      <div class="extra-blocks__action extra-blocks-verbose-cta__action">
        <%= link_to button_label, button_url, class: "button button__lg button__primary extra-blocks__button extra-blocks-verbose-cta__button not-prose" %>
      </div>
    <% end %>
  </div>
<% end %>
