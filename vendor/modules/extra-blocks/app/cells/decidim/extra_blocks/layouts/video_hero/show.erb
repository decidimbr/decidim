<%= content_tag(
  :section,
  class: "extra-blocks-video-hero #{prose_classes}",
  id: "extra-block-#{model.id}",
  data: { extra_blocks_category: "hero" },
  style: section_style
) do %>
  <% if video? %>
    <%= content_tag(:video, class: "extra-blocks__media extra-blocks-video-hero__video", muted: true, loop: true, playsinline: true, preload: "metadata") do %>
      <% video_sources.each do |source| %>
        <%= tag.source src: source[:src], type: source[:type] %>
      <% end %>
    <% end %>
  <% end %>
  <div class="extra-blocks-video-hero__overlay">
    <% if eyebrow.present? || title.present? %>
      <div class="extra-blocks-video-hero__content extra-blocks-video-hero__content--<%= title_position %>">
        <% if eyebrow.present? %>
          <p class="extra-blocks__eyebrow extra-blocks-video-hero__eyebrow"><%= eyebrow %></p>
        <% end %>
        <% if title.present? %>
          <h2 class="extra-blocks__title extra-blocks-video-hero__title"><%= title %></h2>
        <% end %>
        <% if show_button? %>
          <div class="extra-blocks__action extra-blocks-video-hero__action">
            <%= link_to button_label, button_url, class: "button button__lg button__transparent extra-blocks__button extra-blocks-video-hero__button not-prose" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
