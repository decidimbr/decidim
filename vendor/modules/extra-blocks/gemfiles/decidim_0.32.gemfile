# frozen_string_literal: true

# Hand-maintained appraisal gemfile for Decidim 0.32.
# Prefer editing Appraisals then carefully regenerating.

source "https://rubygems.org"

gem "bootsnap", "~> 1.4"
gem "concurrent-ruby", "= 1.3.4"
gem "decidim", "~> 0.32.0"
gem "decidim-conferences", "~> 0.32.0"
gem "decidim-extra_blocks", path: ".."
gem "decidim-initiatives", "~> 0.32.0"
gem "deface", ">= 1.8.1"
gem "decidim-toggle",
    git: "https://git.octree.ch/decidim/vocacity/decidim-modules/decidim-toggle",
    branch: "main"
# Never use path: for sibling deps — git only (extra_blocks itself uses path: "..").
gem "decidim-ephemeral_participation",
    git: "https://git.octree.ch/decidim/vocacity/decidim-modules/decidim-ephemeral_participation",
    branch: "main"
gem "puma", ">= 6.3.1"
gem "rack-proxy", "< 1.0"

group :development, :test do
  gem "appraisal", "~> 2.5", require: false
  gem "better_html"
  gem "brakeman", "~> 6.1"
  gem "byebug", "~> 11.0", platform: :mri
  gem "decidim-dev", "~> 0.32.0"
  gem "parallel_tests", "~> 4.2"
end

group :development do
  gem "letter_opener_web", "~> 2.0"
  gem "listen", "~> 3.1"
  gem "web-console", "~> 4.2"
end

group :test do
  gem "capybara", "~> 3.24"
  gem "rspec-rails", "~> 6.0"
end
